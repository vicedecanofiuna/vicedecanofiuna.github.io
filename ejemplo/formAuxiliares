<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Documentos Obligatorios - Concurso Auxiliar FIUNA</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Segoe UI', Arial, sans-serif; background: #f0f4f8; color: #333; padding: 20px; }
  .container { max-width: 700px; margin: 0 auto; }
  
  header { background: linear-gradient(135deg, #003366, #00509e); color: #fff; padding: 25px; border-radius: 12px; margin-bottom: 20px; text-align: center; }
  header h1 { font-size: 1.4em; margin-bottom: 8px; }
  header p { opacity: 0.9; font-size: 0.9em; }
  
  .card { background: #fff; padding: 25px; border-radius: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); margin-bottom: 20px; }
  .card h2 { color: #003366; font-size: 1.1em; border-bottom: 2px solid #003366; padding-bottom: 10px; margin-bottom: 20px; }
  
  .field { margin-bottom: 18px; }
  .field label { display: block; font-weight: 600; margin-bottom: 6px; font-size: 0.95em; }
  .field .help { font-size: 0.8em; color: #777; margin-bottom: 8px; }
  .field input[type=text], .field input[type=email], .field select { width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 6px; font-size: 0.95em; }
  
  .doc-item { padding: 15px; background: #f9fafb; border-left: 4px solid #00509e; border-radius: 6px; margin-bottom: 12px; }
  .doc-item label { font-weight: 600; display: block; margin-bottom: 6px; font-size: 0.95em; }
  .doc-item .help { font-size: 0.8em; color: #777; margin-bottom: 8px; }
  .doc-item input[type=file] { font-size: 0.9em; width: 100%; }
  
  button { background: #003366; color: #fff; border: none; padding: 15px; font-size: 1em; border-radius: 8px; cursor: pointer; width: 100%; font-weight: 600; margin-top: 10px; }
  button:hover { background: #00509e; }
  button:disabled { background: #999; cursor: not-allowed; }
  
  .status { padding: 15px; border-radius: 8px; margin-top: 15px; display: none; font-size: 0.9em; text-align: center; }
  .status.ok { background: #d4edda; color: #155724; display: block; }
  .status.error { background: #f8d7da; color: #721c24; display: block; }
  .status.info { background: #d1ecf1; color: #0c5460; display: block; }
  
  .footer { text-align: center; color: #888; font-size: 0.8em; margin-top: 20px; padding: 15px; }
</style>
</head>
<body>
<div class="container">

<header>
  <h1>📋 Documentos Obligatorios</h1>
  <p>Concurso Auxiliar de Enseñanza - FIUNA</p>
  <p style="font-size:0.85em; margin-top:5px;">Sede San Lorenzo - Departamento de Ciencias Básicas</p>
</header>

<form id="formDocs" onsubmit="generarZip(event)">

  <!-- DATOS BÁSICOS -->
  <div class="card">
    <h2>👤 Datos del Postulante</h2>
    <div class="field">
      <label>Nombre completo *</label>
      <input type="text" id="nombre" required placeholder="Ej: Juan Pérez">
    </div>
    <div class="field">
      <label>Cédula de Identidad *</label>
      <input type="text" id="ci" required placeholder="Ej: 1234567">
    </div>
    <div class="field">
      <label>Materia a la que postula *</label>
      <select id="materia" required>
        <option value="">-- Seleccione --</option>
        <option value="23011 Mecánica y Calor">23011 Mecánica y Calor</option>
        <option value="23012 Cálculo 1">23012 Cálculo 1</option>
        <option value="23013 Geometría Vectorial">23013 Geometría Vectorial</option>
        <option value="23014 Algebra Moderna">23014 Algebra Moderna</option>
        <option value="23016 Dibujo Técnico">23016 Dibujo Técnico</option>
        <option value="23015 Geometría Descriptiva">23015 Geometría Descriptiva</option>
        <option value="23031 Electricidad y Magnetismo">23031 Electricidad y Magnetismo</option>
        <option value="23032 Ecuaciones Diferenciales">23032 Ecuaciones Diferenciales</option>
        <option value="23033 Probabilidad">23033 Probabilidad</option>
        <option value="23034 Análisis Vectorial">23034 Análisis Vectorial</option>
        <option value="23035 Estática">23035 Estática</option>
        <option value="23431-23731 Estructura de Datos y Algoritmos">23431-23731 Estructura de Datos y Algoritmos</option>
        <option value="23432 Instrumentación Electrónica Básica">23432 Instrumentación Electrónica Básica</option>
        <option value="23531 Físico-Química Ambiental">23531 Físico-Química Ambiental</option>
      </select>
    </div>
  </div>

  <!-- DOCUMENTOS OBLIGATORIOS -->
  <div class="card">
    <h2>📎 Documentos a Presentar</h2>

    <div class="doc-item">
      <label>1. Solicitud de participación (Nota al Decano) *</label>
      <div class="help">Formatos: PDF, JPG</div>
      <input type="file" id="doc_solicitud" accept=".pdf,.jpg,.jpeg,.png" required>
    </div>

    <div class="doc-item">
      <label>2. Certificado de Antecedentes Policiales (Original) *</label>
      <div class="help">Formatos: PDF, JPG</div>
      <input type="file" id="doc_antecedentes" accept=".pdf,.jpg,.jpeg,.png" required>
    </div>

    <div class="doc-item">
      <label>3. Fotocopia de Cédula de Identidad *</label>
      <div class="help">Formatos: PDF, JPG</div>
      <input type="file" id="doc_cedula" accept=".pdf,.jpg,.jpeg,.png" required>
    </div>

    <div class="doc-item">
      <label>4. Currículo Vitae Normalizado (UNA o CONACYT) *</label>
      <div class="help">Debe estar actualizado y firmado. Formatos: PDF, JPG</div>
      <input type="file" id="doc_cv" accept=".pdf,.jpg,.jpeg,.png" required>
    </div>

    <div class="doc-item">
      <label>5. Resumen de Notas (actualizado) *</label>
      <div class="help">Formatos: PDF, JPG</div>
      <input type="file" id="doc_notas" accept=".pdf,.jpg,.jpeg,.png" required>
    </div>

    <div class="doc-item">
      <label>6. Certificado de Estudios (Solo si es de otra Unidad Académica) </label>
      <div class="help">Formatos: PDF, JPG</div>
      <input type="file" id="doc_cert_estudios" accept=".pdf,.jpg,.jpeg,.png">
    </div>

    <div class="doc-item">
      <label>7. Constancia de Antecedentes Disciplinarios (Solo si es de otra Unidad Académica) </label>
      <div class="help">Emitido por la Facultad de origen. Formatos: PDF, JPG</div>
      <input type="file" id="doc_disciplinarios" accept=".pdf,.jpg,.jpeg,.png">
    </div>

    <div class="doc-item">
      <label>8. Constancia Laboral con Horario (Solo si es funcionario público) </label>
      <div class="help">Formatos: PDF, JPG</div>
      <input type="file" id="doc_laboral" accept=".pdf,.jpg,.jpeg,.png">
    </div>
  </div>

  <!-- BOTÓN -->
  <div class="card" style="text-align:center;">
    <button type="submit" id="btnEnviar">📦 Generar ZIP con mis documentos</button>
    <div id="status" class="status"></div>
  </div>

</form>

<div class="footer">
  Concurso Auxiliar FIUNA · <span id="year"></span>
</div>

</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script>
document.getElementById('year').textContent = new Date().getFullYear();

async function generarZip(e) {
  e.preventDefault();
  const status = document.getElementById('status');
  const btn = document.getElementById('btnEnviar');

  try {
    btn.disabled = true;
    status.className = 'status info';
    status.textContent = '⏳ Generando archivo ZIP...';

    const nombre = document.getElementById('nombre').value.trim();
    const ci = document.getElementById('ci').value.trim();
    const materia = document.getElementById('materia').value;

    if (!nombre || !ci || !materia) throw new Error('Complete los datos obligatorios.');

    const nombreCarpeta = nombre.replace(/\s+/g, '-') + '-' + ci;
    const carpetaMateria = materia.replace(/\s+/g, '_');

    const zip = new JSZip();
    const basePath = carpetaMateria + '/' + nombreCarpeta + '/';

    // Lista de documentos (id del input, nombre de archivo final)
    const documentos = [
      { id: 'doc_solicitud', nombre: '01_Solicitud_Decano' },
      { id: 'doc_antecedentes', nombre: '02_Antecedentes_Policiales' },
      { id: 'doc_cedula', nombre: '03_Cedula_Identidad' },
      { id: 'doc_cv', nombre: '04_Curriculo_Vitae' },
      { id: 'doc_notas', nombre: '05_Resumen_Notas' },
      { id: 'doc_cert_estudios', nombre: '06_Certificado_Estudios' },
      { id: 'doc_disciplinarios', nombre: '07_Antecedentes_Disciplinarios' },
      { id: 'doc_laboral', nombre: '08_Constancia_Laboral' }
    ];

    let archivosAgregados = 0;

    for (const doc of documentos) {
      const input = document.getElementById(doc.id);
      const file = input.files[0];
      if (file) {
        const ext = file.name.split('.').pop();
        zip.file(basePath + doc.nombre + '.' + ext, file);
        archivosAgregados++;
      }
    }

    if (archivosAgregados === 0) throw new Error('No se adjuntó ningún documento.');

    const blob = await zip.generateAsync({ type: 'blob' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = carpetaMateria + '_' + nombreCarpeta + '.zip';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);

    status.className = 'status ok';
    status.innerHTML = '✅ ZIP generado correctamente.<br>📁 Carpeta: <strong>' + carpetaMateria + '/' + nombreCarpeta + '/</strong>';
  } catch (err) {
    status.className = 'status error';
    status.textContent = '❌ ' + err.message;
  } finally {
    btn.disabled = false;
  }
}
</script>
</body>
</html>